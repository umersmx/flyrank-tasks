# ==========================================
# SMX AI / Streaming Chat Server Environment
# ==========================================
# NOTE: This key is read exclusively by server-side Route Handlers.
# It is NEVER exposed to the browser client or prefixed with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Default Model override (defaults to claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
